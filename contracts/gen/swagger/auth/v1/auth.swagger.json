  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login аутентифицирует пользователя и возвращает токены.",
        "operationId": "AuthService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1LoginResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "LoginRequest содержит данные для аутентификации.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LoginRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Logout завершает сеанс пользователя.",
        "operationId": "AuthService_Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1LogoutResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "LogoutRequest содержит токен обновления.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LogoutRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/v1/auth/me": {
      "post": {
        "operationId": "AuthService_GetMe",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetMeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1GetMeRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "RefreshToken обновляет токен доступа с помощью токена обновления.",
        "operationId": "AuthService_RefreshToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RefreshTokenResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "RefreshTokenRequest содержит токен обновления.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RefreshTokenRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1GetMeRequest": {
      "type": "object"
    },
    "v1GetMeResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User"
        }
      }
    },
    "v1LoginRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "description": "LoginRequest содержит данные для аутентификации."
    },
    "v1LoginResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        }
      },
      "description": "LoginResponse содержит токены доступа и обновления."
    },
    "v1LogoutRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      },
      "description": "LogoutRequest содержит токен обновления."
    },
    "v1LogoutResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "description": "LogoutResponse содержит результат завершения сеанса."
    },
    "v1Permission": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "$ref": "#/definitions/v1PermissionCode",
          "description": "code код разрешения."
        },
        "name": {
          "type": "string",
          "description": "name название разрешения."
        }
      },
      "description": "Permission определяет права пользователя."
    },
    "v1PermissionCode": {
      "type": "string",
      "enum": [
        "PERMISSION_UNSPECIFIED",
        "PERMISSION_USERS_READ",
        "PERMISSION_USERS_CREATE",
        "PERMISSION_USERS_UPDATE",
        "PERMISSION_USERS_BAN",
        "PERMISSION_USERS_ACTIVATE",
        "PERMISSION_USERS_CHANGE_ROLE",
        "PERMISSION_USERS_ASSIGN_PERMISSION"
      ],
      "default": "PERMISSION_UNSPECIFIED",
      "description": "PermissionCode определяет код для прав."
    },
    "v1RefreshTokenRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      },
      "description": "RefreshTokenRequest содержит токен обновления."
    },
    "v1RefreshTokenResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        }
      },
      "description": "RefreshTokenResponse содержит обновленные токены доступа и обновления."
    },
    "v1Role": {
      "type": "string",
      "enum": [
        "ROLE_UNSPECIFIED",
        "ROLE_STUDENT",
        "ROLE_TEACHER",
        "ROLE_ADMIN"
      ],
      "default": "ROLE_UNSPECIFIED",
      "description": "Role определяет роль пользователя.\n\n - ROLE_UNSPECIFIED: ROLE_UNSPECIFIED указывает на неопределенную роль.\n - ROLE_STUDENT: ROLE_STUDENT указывает на роль студента.\n - ROLE_TEACHER: ROLE_TEACHER указывает на роль преподавателя.\n - ROLE_ADMIN: ROLE_ADMIN указывает на роль администратора."
    },
    "v1User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/v1Role"
        },
        "isActive": {
          "type": "boolean"
        },
        "isBanned": {
          "type": "boolean"
        },
        "banReason": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Permission"
          }
        }
      },
      "description": "User определяет пользователя."
    }
